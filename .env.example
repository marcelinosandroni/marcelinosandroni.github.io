# Canonical origin of this deployment.
#
# Used for the Supabase sign-in redirect, which must be absolute. Left unset the
# origin is taken from the incoming request, which works for local and preview
# deployments, but Supabase's dashboard also needs the production URL allowed in
# its redirect list — this value is what belongs there.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase (server-side only)
# ---------------------------------------------------------------------------
#
# The Vercel integration provides these twice: once as `SUPABASE_*` and once as
# `NEXT_PUBLIC_SUPABASE_*`. Only the `NEXT_PUBLIC_` pair is inlined into the
# browser bundle, permanently and unavoidably.
#
# Nothing here needs a browser-side Supabase client. Owner sign-in is requested
# from a Route Handler so the allowlist is checked *before* any email is sent,
# and the session is read from a server component. So the `SUPABASE_` pair is
# sufficient on its own and the client bundle holds no Supabase credential.
#
# The `POSTGRES_*` variables the integration also sets are not used: this project
# talks to Supabase over its REST API and has no Prisma, no ORM and no direct
# database connection. They can stay in the dashboard.
SUPABASE_URL=https://your-project.supabase.co

# Bypasses row level security. Server-side only. Supabase renamed this from
# `SUPABASE_SERVICE_ROLE_KEY`; same privilege, current name.
SUPABASE_SECRET_KEY=server-only-secret-key

# ---------------------------------------------------------------------------
# Owner authentication (passwordless)
# ---------------------------------------------------------------------------
#
# `/admin` is restricted to the addresses listed here, and nothing else. The
# check is exact address matching, not a substring test, and when ADMIN_EMAIL is
# empty NOBODY is authorised — access fails closed.
#
# More than one owner? Comma separate them: you@example.com,other@example.com
ADMIN_EMAIL=you@example.com

# Optional. A reader of the database can see which elements were clicked; the
# Vercel Supabase integration provisions the `click_aggregates` table if you
# apply the migration. Without it the panel answers from a process-local counter
# and the numbers are not shared between instances.

# ---------------------------------------------------------------------------
# Feature flags — what the site offers
# ---------------------------------------------------------------------------
#
# Both are OFF unless set to `1`, `true`, `yes` or `on`. Anything else — empty,
# a typo, `no`, `off` — reads as off, so a half-finished line here disables the
# feature instead of enabling it by accident.
#
# No `NEXT_PUBLIC_` prefix, on purpose. Every component that reads these is a
# server component, so the prefix would buy nothing — and it would cost the
# feature: Next inlines `NEXT_PUBLIC_*` at build time, which turns a flag into a
# value frozen into an artefact. Change it in the Vercel dashboard, redeploy, and
# it takes effect. With the plain name the value is read when the page renders,
# and it never reaches the browser bundle.
#
# WhatsApp. The phone number appears in four places — the hero's link row, the
# contact section's primary button and channel list, the resume footer, and the
# site footer (both the contact line and the link columns) — and all of them are
# gated together. Off means no `wa.me` link anywhere, not a hidden button over a
# live one. The email brief is never gated: a contact section with no way to
# make contact is not the intent.
#
# Two strings of contact copy name WhatsApp, so the section also carries
# no-WhatsApp variants of its narrative and status line. Those are new copy and
# are marked TODO(review) in `src/infrastructure/content/home/home-pt-br.ts` —
# worth reading before this ships with the flag on, because with it off they are
# the only contact copy there is.
#
# Turning this on publishes a personal phone number to anyone who loads the page.
# That is a deliberate act, so it takes an explicit value.
NEXT_PUBLIC_FEATURE_WHATSAPP=off

# Resume download. Off means both the button and the endpoint are gone: the
# button is not rendered, and `GET /api/resume/{locale}/pdf` answers 404 before
# it validates the locale or compiles anything. The live-resume page still reads
# in full on the site; this controls distributing it as a file.
#
# Worth knowing: the PDFs are also published to `public/artifacts` by the
# `compile-pdf` workflow, which runs on tags and is not gated by this variable.
# If the point is "not downloadable", that path needs a look too.
NEXT_PUBLIC_FEATURE_RESUME_DOWNLOAD=off

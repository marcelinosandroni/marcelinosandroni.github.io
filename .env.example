NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-key

# ---------------------------------------------------------------------------
# Owner authentication (passwordless magic link)
#
# `/admin` is restricted to the addresses listed in ADMIN_EMAIL, and nothing
# else. The check is exact address matching, not a substring test, and when
# ADMIN_EMAIL is empty NOBODY is authorised — access fails closed.
#
# More than one owner? Comma separate them: you@example.com,other@example.com
# ---------------------------------------------------------------------------
ADMIN_EMAIL=you@example.com

# Secret used to sign sessions. Generate with:
#   npx auth secret
# Leave empty and owner auth is disabled rather than falling back to a
# predictable value.
AUTH_SECRET=

# Transactional email, via Resend. The sender must be a verified domain in the
# Resend dashboard; the default only works for the Resend sandbox.
RESEND_API_KEY=
AUTH_EMAIL_FROM=you@example.com

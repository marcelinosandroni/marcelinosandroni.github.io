{
  "name": "marcelino-resume-platform",
  "version": "0.22.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:commit": "commitlint --verbose",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "tsx scripts/run-e2e.ts",
    "test:e2e:direct": "playwright test",
    "test:e2e:default-flags": "playwright test --config playwright.default-flags.config.ts",
    "test:e2e:debug": "playwright test --debug",
    "compile:pdf": "tsx scripts/compile-pdf.ts",
    "pdf:from-html": "tsx scripts/html-to-pdf.ts",
    "pdf:recruiter": "tsx scripts/html-to-pdf.ts resume-recruiter-pt-br.html resume-recruiter-pt-br.pdf",
    "resume:build-en": "tsx scripts/build-english-resume.ts",
    "pdf:fixed": "tsx scripts/html-to-pdf.ts resume-recruiter-pt-br.html public/artifacts/fixed/resume-fixed-pt-BR.pdf",
    "pdf:fixed:en": "tsx scripts/html-to-pdf.ts resume-recruiter-en-us.html public/artifacts/fixed/resume-fixed-en-US.pdf",
    "pdf:fixed:all": "npm run pdf:fixed && npm run pdf:fixed:en",
    "resume:build-variants": "tsx scripts/build-stack-variants.ts",
    "resume:measure": "tsx scripts/measure-resume.ts",
    "resume:check-layout": "tsx scripts/check-layout.ts",
    "resume:prompt": "tsx scripts/write-variant-prompt.ts",
    "pdf:fixed:variants": "npm run resume:build-variants && tsx scripts/render-variant-pdfs.ts",
    "pdf:fixed:everything": "npm run resume:build-variants && npm run resume:build-en && npm run pdf:fixed:all && npm run pdf:fixed:variants",
    "pdf:fixed:build": "npm run artifacts:clean && npm run pdf:fixed:everything && tsx scripts/verify-fixed-artifacts.ts",
    "artifacts:clean": "tsx scripts/clean-artifacts.ts",
    "artifacts:purge": "tsx scripts/clean-artifacts.ts --purge-fixed",
    "encode:portrait": "tsx scripts/encode-portrait-video.ts",
    "compile:pdf:watch": "node --watch scripts/compile-pdf.ts",
    "generate:blog-seed": "tsx scripts/generate-blog-seed.ts",
    "db:up": "docker compose -f docker-compose.supabase.yml up -d",
    "db:down": "docker compose -f docker-compose.supabase.yml down",
    "db:reset": "docker compose -f docker-compose.supabase.yml down -v",
    "db:keys": "tsx scripts/db-local-keys.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:bootstrap": "tsx scripts/db-seed-resume.ts",
    "db:setup": "npm run db:up && npm run db:keys && npm run db:migrate && npm run db:bootstrap"
  },
  "dependencies": {
    "@formatjs/intl-localematcher": "^0.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.112.4",
    "@types/negotiator": "^0.6.5",
    "@vercel/analytics": "^1.3.2",
    "negotiator": "^1.1.0",
    "next": "^16.3.4",
    "pdfkit": "^0.20.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3",
    "conventional-changelog-angular": "^9.4.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "pg": "^8.23.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}

{
  "name": "marcelino-resume-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:commit": "commitlint --verbose",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:debug": "playwright test --debug",
    "compile:pdf": "tsx scripts/compile-pdf.ts",
    "compile:pdf:watch": "node --watch scripts/compile-pdf.ts",
    "generate:blog-seed": "tsx scripts/generate-blog-seed.ts"
  },
  "dependencies": {
    "@auth/supabase-adapter": "^1.11.3",
    "@formatjs/intl-localematcher": "^0.9.0",
    "@supabase/supabase-js": "^2.112.4",
    "@types/negotiator": "^0.6.5",
    "negotiator": "^1.1.0",
    "next": "^16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "pdfkit": "^0.20.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.30.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3",
    "conventional-changelog-angular": "^9.4.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
